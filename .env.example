# ==============================================================================
# Nasiko Sentinel - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local environment.
# DO NOT commit .env files containing production credentials or secrets.
# ==============================================================================

# Core Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=nasiko-sentinel
APP_VERSION=0.1.0

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio

# ------------------------------------------------------------------------------
# Future Phase Placeholders (NOT REQUIRED FOR PHASE 1)
